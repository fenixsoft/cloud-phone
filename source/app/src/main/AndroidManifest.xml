<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 输入窗口合成驱动（SPEC 5.3 InputComposer）：透明 1×1 悬窗 5fps 强制 display 0 合成；
         需 bootstrap appops 登记（特殊权限，无运行时弹窗），未授权时自动降级 1Hz idle 合成 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- APP_LIST 枚举可见性（Android 11+ package filtering）：仅声明可启动应用查询面 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="CloudPhone Source"
        android:theme="@android:style/Theme.Material"
        android:allowBackup="false">

        <activity
            android:name="cloudphone.source.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="cloudphone.source.StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 云剪贴板输入法（aux-channels-m3 任务 3.2）：极简焦点代理，无键盘 UI。
             BIND_INPUT_METHOD 系统权限保护 + android.view.InputMethod intent-filter +
             xml/method.xml 元数据——Android 10+ 剪贴板读写与中文注入的合法焦点载体 -->
        <service
            android:name="cloudphone.source.ime.CloudImeService"
            android:exported="true"
            android:label="云剪贴板输入法"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
