<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="CloudPhone Client"
        android:theme="@android:style/Theme.Material"
        android:allowBackup="false">

        <activity
            android:name="cloudphone.client.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="cloudphone.client.ConnectActivity"
            android:exported="false" />

        <activity
            android:name="cloudphone.client.DecodeRenderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name="cloudphone.client.SessionDrawerActivity"
            android:exported="false" />
    </application>
</manifest>
