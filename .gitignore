# ── Fenix Loop Engineering Framework ──

# Python
__pycache__/
*.pyc
*.pyo

# Worktrees (managed by fenixd)
.claude/worktrees/

# 本地工具状态（admin 认领 maintree_untracked_stray_escalated 0181f897bba707d0：
# .claude/agents 为指向 fenixd 的 agent 配置符号链接、.local 为 gh CLI 设备状态，
# 均为运行时本地状态，不入库）
.claude/
.local/

# 运行时/敏感目录（.fenix/config.yaml 含 API Key，绝不提交）
# 用 /* 而非 .fenix/：目录整体排除后无法用 ! 放行其下入库文件
.fenix/*
.playwright-cli/

# 例外：状态文件随仓库入库（todo.md 自省条目 / verify.yaml 验证契约）
# 项目如需版本化其它状态文件（如 .fenix/STATE.md / PROJECT_LOG.md），
# 在此追加 `!` 规则即可。
!.fenix/todo.md
!.fenix/verify.yaml

# ── Android / Gradle 构建产物与本地配置 ──
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/

# ── superpowers 会话临时产物（brainstorm 视觉伴侣截图等，运行时本地状态） ──
.superpowers/
